<Window x:Class="ShopPro.UI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShopPro Retail POS — Authentication" Height="500" Width="450"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource BgDarkBrush}">
    
    <Grid Margin="30">
        <Border Style="{StaticResource CardBorderStyle}" VerticalAlignment="Center">
            <StackPanel Margin="10">
                <TextBlock Text="SHOPPRO RETAIL POS" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="22" FontWeight="Black" HorizontalAlignment="Center"/>
                <TextBlock Text="Native Offline-First .NET 8 Workstation" Foreground="{StaticResource TextMutedBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,24"/>

                <TextBlock Text="Username" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtUsername" Height="40" Background="#0F172A" Foreground="White" BorderBrush="{StaticResource SurfaceBorderBrush}" Padding="10,8" FontSize="14" Margin="0,0,0,16"/>

                <TextBlock Text="Password" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <PasswordBox x:Name="TxtPassword" Height="40" Background="#0F172A" Foreground="White" BorderBrush="{StaticResource SurfaceBorderBrush}" Padding="10,8" FontSize="14" Margin="0,0,0,24"/>

                <Button Content="SIGN IN TO WORKSTATION" Style="{StaticResource PrimaryButtonStyle}" Height="45" Click="BtnLogin_Click"/>

                <TextBlock x:Name="TxtError" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,16,0,0" HorizontalAlignment="Center" TextWrapping="Wrap"/>

                <Border Margin="0,20,0,0" Padding="10" Background="#0F172A" CornerRadius="6">
                    <TextBlock Text="Default Credentials:&#10;Admin: admin / admin123&#10;Cashier: cashier / cashier123" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextAlignment="Center"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
