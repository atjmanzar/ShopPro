<Window x:Class="ShopPro.UI.Views.StockAdjustmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adjust Inventory Stock" Height="360" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgDarkBrush}">
    
    <Grid Margin="24">
        <StackPanel>
            <TextBlock x:Name="TxtProductName" Text="Product Name" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>

            <TextBlock Text="Quantity Adjustment (+/-)" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtQtyChange" Height="40" Background="#0F172A" Foreground="White" BorderBrush="{StaticResource SurfaceBorderBrush}" Padding="10,8" FontSize="14" Margin="0,0,0,16"/>

            <TextBlock Text="Reason for Adjustment" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtReason" Height="40" Background="#0F172A" Foreground="White" BorderBrush="{StaticResource SurfaceBorderBrush}" Padding="10,8" FontSize="14" Margin="0,0,0,24"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource PrimaryButtonStyle}" Background="#334155" Width="100" Margin="0,0,12,0" Click="BtnCancel_Click"/>
                <Button Content="Save Audit Log" Style="{StaticResource PrimaryButtonStyle}" Width="140" Click="BtnSave_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
