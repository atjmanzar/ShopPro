<Page x:Class="ShopPro.UI.Views.InventoryView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Inventory Management">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Dashboard Summary Cards -->
        <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,16">
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Total Active Products" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                    <TextBlock x:Name="TxtDashTotalProducts" Text="0" Foreground="White" FontSize="22" FontWeight="Black" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Total Valuation (Cost / Retail)" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                    <TextBlock x:Name="TxtDashValuation" Text="₹0 / ₹0" Foreground="{StaticResource SuccessBrush}" FontSize="16" FontWeight="Black" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Low Stock Reorder Alert" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                    <TextBlock x:Name="TxtDashLowStock" Text="0" Foreground="{StaticResource WarningBrush}" FontSize="22" FontWeight="Black" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Out of Stock Items" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                    <TextBlock x:Name="TxtDashOutOfStock" Text="0" Foreground="{StaticResource DangerBrush}" FontSize="22" FontWeight="Black" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Header Controls Bar -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Show All" Style="{StaticResource PrimaryButtonStyle}" Background="#334155" Height="36" Click="BtnShowAll_Click"/>
                    <Button Content="Low Stock" Style="{StaticResource PrimaryButtonStyle}" Background="#334155" Margin="8,0,0,0" Height="36" Click="BtnFilterLowStock_Click"/>
                    <Button Content="Out of Stock" Style="{StaticResource PrimaryButtonStyle}" Background="#334155" Margin="8,0,0,0" Height="36" Click="BtnFilterOutOfStock_Click"/>
                    <Button Content="📂 Manage Categories" Style="{StaticResource PrimaryButtonStyle}" Background="#334155" Margin="16,0,0,0" Height="36" Click="BtnManageCategories_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="✏️ Edit Selected" Style="{StaticResource PrimaryButtonStyle}" Background="#334155" Margin="0,0,8,0" Height="36" Click="BtnEditProduct_Click"/>
                    <Button Content="📦 Adjust Stock" Style="{StaticResource PrimaryButtonStyle}" Background="#334155" Margin="0,0,8,0" Height="36" Click="BtnAdjustStock_Click"/>
                    <Button Content="+ Add Product" Style="{StaticResource PrimaryButtonStyle}" Height="36" Click="BtnAddProduct_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Products DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
            <DataGrid x:Name="DgProducts" AutoGenerateColumns="False" IsReadOnly="True" 
                      Background="Transparent" RowHeight="40" HeadersVisibility="Column" 
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155" BorderThickness="0">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#0F172A" />
                        <Setter Property="Foreground" Value="#94A3B8" />
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="Padding" Value="10,8" />
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="110"/>
                    <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="140"/>
                    <DataGridTextColumn Header="Product Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category.Name}" Width="140"/>
                    <DataGridTextColumn Header="Selling Price" Binding="{Binding Price, StringFormat=₹{0:N2}}" Width="110"/>
                    <DataGridTextColumn Header="Cost Price" Binding="{Binding Cost, StringFormat=₹{0:N2}}" Width="100"/>
                    <DataGridTextColumn Header="Stock Qty" Binding="{Binding StockQuantity}" Width="90"/>
                    <DataGridTextColumn Header="Reorder Level" Binding="{Binding ReorderLevel}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
