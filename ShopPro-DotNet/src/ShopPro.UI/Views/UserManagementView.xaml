<UserControl x:Class="ShopPro.UI.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="20">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Actions -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <DockPanel>
                <TextBlock Text="USER MANAGEMENT &amp; ROLE PERMISSIONS" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Content="+ Create New User Account" Style="{StaticResource PrimaryButtonStyle}" DockPanel.Dock="Right" Height="36" Click="BtnCreateUser_Click"/>
            </DockPanel>
        </Border>

        <!-- Users Grid -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
            <DataGrid x:Name="DgUsers" AutoGenerateColumns="False" IsReadOnly="True" 
                      Background="Transparent" RowHeight="44" HeadersVisibility="Column" 
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155" BorderThickness="0">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#0F172A" />
                        <Setter Property="Foreground" Value="#94A3B8" />
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="Padding" Value="10,8" />
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="Padding" Value="10,8" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="120"/>
                    <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="180"/>
                    <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="100"/>
                    <DataGridCheckBoxColumn Header="Products" Binding="{Binding CanManageProducts}" Width="80"/>
                    <DataGridCheckBoxColumn Header="Discounts" Binding="{Binding CanGiveDiscount}" Width="80"/>
                    <DataGridCheckBoxColumn Header="Reports" Binding="{Binding CanViewReports}" Width="80"/>
                    <DataGridCheckBoxColumn Header="Void Sales" Binding="{Binding CanVoidSale}" Width="80"/>
                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
