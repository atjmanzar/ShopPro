<Window x:Class="ShopPro.UI.Views.CategoryManagementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Category Master Manager" Height="480" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgDarkBrush}">
    
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Category DataGrid -->
        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,16,0">
            <DataGrid x:Name="DgCategories" AutoGenerateColumns="False" IsReadOnly="True" 
                      Background="Transparent" RowHeight="36" HeadersVisibility="Column" 
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155" BorderThickness="0"
                      SelectionChanged="DgCategories_SelectionChanged">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#0F172A" />
                        <Setter Property="Foreground" Value="#94A3B8" />
                        <Setter Property="FontWeight" Value="Bold" />
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="White" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Category Name" Binding="{Binding Name}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Edit Form -->
        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock x:Name="TxtTitle" Text="Create Category" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>

                <TextBlock Text="Category Name" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtCatName" Height="36" Background="#0F172A" Foreground="White" BorderBrush="{StaticResource SurfaceBorderBrush}" Padding="8,6" Margin="0,0,0,12"/>

                <TextBlock Text="Description" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtCatDesc" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Background="#0F172A" Foreground="White" BorderBrush="{StaticResource SurfaceBorderBrush}" Padding="8,6" Margin="0,0,0,20"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="Save Category" Style="{StaticResource PrimaryButtonStyle}" Height="36" Margin="0,0,10,0" Click="BtnSave_Click"/>
                    <Button Content="New Category" Style="{StaticResource PrimaryButtonStyle}" Background="#334155" Height="36" Click="BtnNew_Click"/>
                </StackPanel>

                <Button Content="❌ Delete Selected (With Protection)" Style="{StaticResource PrimaryButtonStyle}" Background="{StaticResource DangerBrush}" Height="36" Click="BtnDelete_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
