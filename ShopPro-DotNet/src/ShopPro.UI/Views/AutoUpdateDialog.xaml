<Window x:Class="ShopPro.UI.Views.AutoUpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShopPro Auto Update" Height="460" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgDarkBrush}">
    
    <Grid Margin="24">
        <StackPanel>
            <TextBlock Text="NEW VERSION AVAILABLE!" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock x:Name="TxtVersionHeading" Text="ShopPro v1.1.0 is available for installation" Foreground="White" FontSize="14" Margin="0,0,0,16"/>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Height="180">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Release Notes:" Foreground="{StaticResource TextMutedBrush}" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TxtReleaseNotes" Text="• Loading release notes..." Foreground="#E2E8F0" TextWrapping="Wrap" LineHeight="20"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <ProgressBar x:Name="PbDownload" Height="10" Foreground="{StaticResource PrimaryAccentBrush}" Background="#0F172A" Margin="0,0,0,16" Visibility="Collapsed"/>
            <TextBlock x:Name="TxtStatus" Text="Ready to download and install update." Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Remind Me Later" Style="{StaticResource PrimaryButtonStyle}" Background="#334155" Width="140" Margin="0,0,12,0" Click="BtnLater_Click"/>
                <Button x:Name="BtnInstall" Content="⚡ Download &amp; Install Update" Style="{StaticResource PrimaryButtonStyle}" Width="200" Click="BtnInstall_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
