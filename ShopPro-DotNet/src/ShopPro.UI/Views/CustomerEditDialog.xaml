<Window x:Class="ShopPro.UI.Views.CustomerEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customer Account Master" Height="480" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgDarkBrush}">
    
    <Grid Margin="24">
        <StackPanel>
            <TextBlock x:Name="TxtTitle" Text="Create Customer Account" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

            <TextBlock Text="Customer Full Name" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtName" Height="36" Background="#0F172A" Foreground="White" BorderBrush="{StaticResource SurfaceBorderBrush}" Padding="8,6" Margin="0,0,0,12"/>

            <UniformGrid Columns="2" Margin="0,0,0,12">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Phone Number" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtPhone" Height="36" Background="#0F172A" Foreground="White" BorderBrush="{StaticResource SurfaceBorderBrush}" Padding="8,6"/>
                </StackPanel>
                <StackPanel Margin="8,0,0,0">
                    <TextBlock Text="Email Address" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtEmail" Height="36" Background="#0F172A" Foreground="White" BorderBrush="{StaticResource SurfaceBorderBrush}" Padding="8,6"/>
                </StackPanel>
            </UniformGrid>

            <TextBlock Text="Address / Location" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtAddress" Height="36" Background="#0F172A" Foreground="White" BorderBrush="{StaticResource SurfaceBorderBrush}" Padding="8,6" Margin="0,0,0,12"/>

            <TextBlock Text="GSTIN Tax Number" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtGstin" Height="36" Background="#0F172A" Foreground="White" BorderBrush="{StaticResource SurfaceBorderBrush}" Padding="8,6" Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource PrimaryButtonStyle}" Background="#334155" Width="100" Margin="0,0,12,0" Click="BtnCancel_Click"/>
                <Button Content="Save Customer" Style="{StaticResource PrimaryButtonStyle}" Width="140" Click="BtnSave_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
