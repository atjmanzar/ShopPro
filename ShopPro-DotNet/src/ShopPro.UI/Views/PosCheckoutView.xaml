<Page x:Class="ShopPro.UI.Views.PosCheckoutView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="POS Checkout">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <!-- Left Area: Barcode Search & Cart DataGrid -->
        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Search & Scan Barcode Box -->
            <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Content="⏸️ Hold Sale" Style="{StaticResource PrimaryButtonStyle}" Background="#334155" Height="40" Margin="10,0,0,0" Click="BtnHoldSale_Click"/>
                        <Button Content="▶️ Resume Sale" Style="{StaticResource PrimaryButtonStyle}" Background="#334155" Height="40" Margin="8,0,0,0" Click="BtnResumeSale_Click"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TxtSearchBarcode" Height="40" Background="#0F172A" Foreground="White" 
                                 BorderBrush="{StaticResource SurfaceBorderBrush}" Padding="12,8" FontSize="15" 
                                 GotFocus="TxtSearchBarcode_GotFocus" KeyDown="TxtSearchBarcode_KeyDown"/>

                        <Button Grid.Column="1" Content="Add to Cart" Style="{StaticResource PrimaryButtonStyle}" 
                                Height="40" Margin="12,0,0,0" Click="BtnAddProduct_Click"/>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Cart DataGrid -->
            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <DataGrid x:Name="DgCart" AutoGenerateColumns="False" CanUserAddRows="False" 
                          Background="Transparent" RowHeight="44" HeadersVisibility="Column" 
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155" BorderThickness="0">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#0F172A" />
                            <Setter Property="Foreground" Value="#94A3B8" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="Padding" Value="10,8" />
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="Padding" Value="10,8" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Item Name" Binding="{Binding Product.Name}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding EffectivePrice, StringFormat=₹{0:N2}}" Width="90"/>
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="60"/>
                        <DataGridTextColumn Header="Disc %" Binding="{Binding DiscountPercentage}" Width="70"/>
                        <DataGridTextColumn Header="Tax %" Binding="{Binding TaxRate}" Width="60" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat=₹{0:N2}}" Width="100" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Quick Cart Action Bar -->
            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="Invoice Discount (%):" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="TxtInvoiceDiscountPct" Width="70" Height="36" Background="#0F172A" Foreground="White" BorderBrush="{StaticResource SurfaceBorderBrush}" Padding="6,6" TextChanged="TxtInvoiceDiscount_TextChanged"/>
                    </StackPanel>

                    <Button Content="Clear Cart" Style="{StaticResource PrimaryButtonStyle}" Background="#334155" DockPanel.Dock="Right" Height="36" Click="BtnClearCart_Click"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Right Sidebar: Billing Summary & Payment -->
        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="BILLING SUMMARY" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

                <!-- Summary Breakdown -->
                <StackPanel Grid.Row="1">
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="Subtotal:" Foreground="{StaticResource TextMutedBrush}" FontSize="14"/>
                        <TextBlock x:Name="TxtSubtotal" Text="₹0.00" Foreground="White" FontSize="14" FontWeight="Bold" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="Total Discount:" Foreground="{StaticResource TextMutedBrush}" FontSize="14"/>
                        <TextBlock x:Name="TxtTotalDiscount" Text="₹0.00" Foreground="{StaticResource WarningBrush}" FontSize="14" FontWeight="Bold" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="Total GST Tax:" Foreground="{StaticResource TextMutedBrush}" FontSize="14"/>
                        <TextBlock x:Name="TxtTotalTax" Text="₹0.00" Foreground="White" FontSize="14" FontWeight="Bold" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                    </DockPanel>
                    
                    <TextBlock x:Name="TxtTaxBreakdown" Text="CGST: ₹0.00 | SGST: ₹0.00" Foreground="{StaticResource TextMutedBrush}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,0,12"/>

                    <Separator Background="{StaticResource SurfaceBorderBrush}" Margin="0,4,0,12"/>

                    <DockPanel Margin="0,4,0,16">
                        <TextBlock Text="GRAND TOTAL:" Foreground="White" FontSize="18" FontWeight="Black"/>
                        <TextBlock x:Name="TxtGrandTotal" Text="₹0.00" Foreground="{StaticResource SuccessBrush}" FontSize="24" FontWeight="Black" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <TextBlock Text="Payment Method" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbPaymentMethod" Height="40" Background="#0F172A" Foreground="White" Margin="0,0,0,12">
                        <ComboBoxItem Content="Cash Payment" IsSelected="True"/>
                        <ComboBoxItem Content="Credit / Debit Card"/>
                        <ComboBoxItem Content="UPI Mobile Payment"/>
                        <ComboBoxItem Content="Store Credit Sale"/>
                    </ComboBox>

                    <TextBlock Text="Amount Tendered" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtAmountPaid" Height="42" Background="#0F172A" Foreground="White" 
                             BorderBrush="{StaticResource SurfaceBorderBrush}" Padding="12,8" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Row="2">
                    <Button Content="⚡ COMPLETE CHECKOUT &amp; PRINT" Style="{StaticResource PrimaryButtonStyle}" 
                            Height="55" FontSize="16" Click="BtnCheckout_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
