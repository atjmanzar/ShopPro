<Window x:Class="ShopPro.UI.Views.ExpenseManagementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Store Operating Expenses" Height="480" Width="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgDarkBrush}">
    
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <!-- Expenses DataGrid -->
        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,16,0">
            <DataGrid x:Name="DgExpenses" AutoGenerateColumns="False" IsReadOnly="True" 
                      Background="Transparent" RowHeight="36" HeadersVisibility="Column" 
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155" BorderThickness="0">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#0F172A" />
                        <Setter Property="Foreground" Value="#94A3B8" />
                        <Setter Property="FontWeight" Value="Bold" />
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="White" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100"/>
                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=₹{0:N2}}" Width="90"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding ExpenseDate, StringFormat={}{0:MM-dd HH:mm}}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- New Expense Form -->
        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock Text="Record Expense" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>

                <TextBlock Text="Category" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbCategory" Height="36" Background="#0F172A" Foreground="White" Margin="0,0,0,12">
                    <ComboBoxItem Content="Rent &amp; Utilities" IsSelected="True"/>
                    <ComboBoxItem Content="Staff Salaries"/>
                    <ComboBoxItem Content="Store Maintenance"/>
                    <ComboBoxItem Content="Supplies &amp; Packaging"/>
                    <ComboBoxItem Content="Marketing &amp; Ads"/>
                    <ComboBoxItem Content="Miscellaneous"/>
                </ComboBox>

                <TextBlock Text="Expense Title" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtTitle" Height="36" Background="#0F172A" Foreground="White" BorderBrush="{StaticResource SurfaceBorderBrush}" Padding="8,6" Margin="0,0,0,12"/>

                <TextBlock Text="Amount (₹)" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtAmount" Height="36" Background="#0F172A" Foreground="White" BorderBrush="{StaticResource SurfaceBorderBrush}" Padding="8,6" Margin="0,0,0,20"/>

                <Button Content="➕ Add Expense Record" Style="{StaticResource PrimaryButtonStyle}" Height="40" Click="BtnAddExpense_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
