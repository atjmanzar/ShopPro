<Window x:Class="ShopPro.UI.Views.ShiftManagementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Till Reconciliation &amp; Cash Shift" Height="420" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgDarkBrush}">
    
    <Grid Margin="24">
        <StackPanel>
            <TextBlock x:Name="TxtTitle" Text="CASH SHIFT RECONCILIATION" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Opening Float:" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock x:Name="TxtOpeningFloat" Text="₹0.00" Foreground="White" FontWeight="Bold" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Cash Sales Inflow:" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock x:Name="TxtCashSales" Text="₹0.00" Foreground="White" FontWeight="Bold" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <Separator Background="{StaticResource SurfaceBorderBrush}" Margin="0,4,0,8"/>
                    <DockPanel>
                        <TextBlock Text="EXPECTED CASH IN TILL:" Foreground="White" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtExpectedCash" Text="₹0.00" Foreground="{StaticResource SuccessBrush}" FontWeight="Black" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Actual Counted Cash (₹)" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtCountedCash" Height="40" Background="#0F172A" Foreground="White" 
                     BorderBrush="{StaticResource SurfaceBorderBrush}" Padding="10,8" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" TextChanged="TxtCountedCash_TextChanged"/>

            <DockPanel Margin="0,0,0,20">
                <TextBlock Text="Cash Variance (Over / Short):" Foreground="White" FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtVariance" Text="₹0.00" Foreground="{StaticResource WarningBrush}" FontSize="16" FontWeight="Bold" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
            </DockPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource PrimaryButtonStyle}" Background="#334155" Width="100" Margin="0,0,12,0" Click="BtnCancel_Click"/>
                <Button Content="🔒 Close Shift &amp; Reconcile" Style="{StaticResource PrimaryButtonStyle}" Width="200" Click="BtnCloseShift_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
