<Window x:Class="ShopPro.UI.Views.LicenseActivationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShopPro Commercial Activation" Height="420" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgDarkBrush}">
    
    <Grid Margin="24">
        <StackPanel>
            <TextBlock Text="COMMERCIAL LICENSE ACTIVATION" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

            <TextBlock Text="Workstation Machine ID (Hardware Fingerprint)" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtMachineId" Height="36" Background="#0F172A" Foreground="{StaticResource SuccessBrush}" FontFamily="Consolas" FontWeight="Bold" IsReadOnly="True" Padding="8,6" Margin="0,0,0,12"/>

            <TextBlock Text="Registered Customer / Company Name" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtCustomerName" Height="36" Background="#0F172A" Foreground="White" BorderBrush="{StaticResource SurfaceBorderBrush}" Padding="8,6" Margin="0,0,0,12"/>

            <TextBlock Text="Commercial License Key (PRO-XXXX-XXXX)" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtLicenseKey" Height="40" Background="#0F172A" Foreground="White" BorderBrush="{StaticResource SurfaceBorderBrush}" Padding="8,6" FontSize="16" FontFamily="Consolas" Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource PrimaryButtonStyle}" Background="#334155" Width="100" Margin="0,0,12,0" Click="BtnCancel_Click"/>
                <Button Content="🔑 Activate License" Style="{StaticResource PrimaryButtonStyle}" Width="160" Click="BtnActivate_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
