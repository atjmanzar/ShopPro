<Window x:Class="ShopPro.UI.Views.UserEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create User Account" Height="500" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgDarkBrush}">
    
    <Grid Margin="24">
        <StackPanel>
            <TextBlock Text="CREATE NEW USER ACCOUNT" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

            <TextBlock Text="Username" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtUsername" Height="36" Background="#0F172A" Foreground="White" BorderBrush="{StaticResource SurfaceBorderBrush}" Padding="8,6" Margin="0,0,0,12"/>

            <TextBlock Text="Full Name" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtFullName" Height="36" Background="#0F172A" Foreground="White" BorderBrush="{StaticResource SurfaceBorderBrush}" Padding="8,6" Margin="0,0,0,12"/>

            <TextBlock Text="Password" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <PasswordBox x:Name="TxtPassword" Height="36" Background="#0F172A" Foreground="White" BorderBrush="{StaticResource SurfaceBorderBrush}" Padding="8,6" Margin="0,0,0,12"/>

            <TextBlock Text="Assigned Role" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ComboBox x:Name="CmbRole" Height="36" Background="#0F172A" Foreground="White" Margin="0,0,0,16">
                <ComboBoxItem Content="Cashier" IsSelected="True"/>
                <ComboBoxItem Content="Manager"/>
                <ComboBoxItem Content="Administrator"/>
            </ComboBox>

            <TextBlock Text="Granular Permissions" Foreground="{StaticResource TextMutedBrush}" FontWeight="Bold" Margin="0,0,0,8"/>
            <CheckBox x:Name="ChkManageProducts" Content="Can Manage Products &amp; Inventory" Foreground="White" Margin="0,0,0,6" IsChecked="True"/>
            <CheckBox x:Name="ChkGiveDiscount" Content="Can Give Item / Invoice Discounts" Foreground="White" Margin="0,0,0,6" IsChecked="True"/>
            <CheckBox x:Name="ChkViewReports" Content="Can Access Reports &amp; Financial Analytics" Foreground="White" Margin="0,0,0,6"/>
            <CheckBox x:Name="ChkVoidSale" Content="Can Void Completed Sales" Foreground="White" Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource PrimaryButtonStyle}" Background="#334155" Width="100" Margin="0,0,12,0" Click="BtnCancel_Click"/>
                <Button Content="Create User" Style="{StaticResource PrimaryButtonStyle}" Width="130" Click="BtnSave_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
