<UserControl x:Class="ShopPro.UI.Views.CustomerManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="20">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Actions -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <DockPanel>
                <TextBlock Text="CUSTOMER &amp; LOYALTY MANAGEMENT" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="✏️ Edit Customer" Style="{StaticResource PrimaryButtonStyle}" Background="#334155" Margin="0,0,8,0" Height="36" Click="BtnEditCustomer_Click"/>
                    <Button Content="+ Add Customer" Style="{StaticResource PrimaryButtonStyle}" Height="36" Click="BtnAddCustomer_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Customers Grid -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
            <DataGrid x:Name="DgCustomers" AutoGenerateColumns="False" IsReadOnly="True" 
                      Background="Transparent" RowHeight="40" HeadersVisibility="Column" 
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155" BorderThickness="0">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#0F172A" />
                        <Setter Property="Foreground" Value="#94A3B8" />
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="Padding" Value="10,8" />
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="Padding" Value="10,8" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Customer Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="130"/>
                    <DataGridTextColumn Header="GSTIN" Binding="{Binding Gstin}" Width="140"/>
                    <DataGridTextColumn Header="Tier" Binding="{Binding Tier}" Width="90"/>
                    <DataGridTextColumn Header="Loyalty Points" Binding="{Binding LoyaltyPoints}" Width="110"/>
                    <DataGridTextColumn Header="Credit Balance" Binding="{Binding CreditBalance, StringFormat=₹{0:N2}}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
