<Page x:Class="ShopPro.UI.Views.ReportsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Sales &amp; Financial Analytics">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top P&L Financial Cards -->
        <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,16">
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Gross Sales Revenue" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                    <TextBlock x:Name="TxtGrossRevenue" Text="₹0.00" Foreground="White" FontSize="20" FontWeight="Black" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Cost of Goods Sold (COGS)" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                    <TextBlock x:Name="TxtCogs" Text="₹0.00" Foreground="{StaticResource WarningBrush}" FontSize="20" FontWeight="Black" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Operating Expenses" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                    <TextBlock x:Name="TxtExpenses" Text="₹0.00" Foreground="{StaticResource DangerBrush}" FontSize="20" FontWeight="Black" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Net Profit (Margin %)" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                    <TextBlock x:Name="TxtNetProfit" Text="₹0.00 (0%)" Foreground="{StaticResource SuccessBrush}" FontSize="20" FontWeight="Black" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Header Actions & Date Range -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="REPORTS &amp; FINANCIAL ANALYTICS" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Content="🗓️ Today" Style="{StaticResource PrimaryButtonStyle}" Background="#334155" Margin="20,0,0,0" Height="36" Click="BtnFilterToday_Click"/>
                    <Button Content="🗓️ Last 30 Days" Style="{StaticResource PrimaryButtonStyle}" Background="#334155" Margin="8,0,0,0" Height="36" Click="BtnFilterMonth_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="💸 Manage Expenses" Style="{StaticResource PrimaryButtonStyle}" Background="#334155" Margin="0,0,8,0" Height="36" Click="BtnManageExpenses_Click"/>
                    <Button Content="📄 Export PDF Report" Style="{StaticResource PrimaryButtonStyle}" Background="#334155" Margin="0,0,8,0" Height="36" Click="BtnExportPdf_Click"/>
                    <Button Content="📊 Export Excel XML" Style="{StaticResource PrimaryButtonStyle}" Height="36" Click="BtnExportExcel_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Tabbed Analytics -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
            <TabControl Background="Transparent" BorderThickness="0">
                <TabItem Header="Sales Invoices">
                    <DataGrid x:Name="DgSales" AutoGenerateColumns="False" IsReadOnly="True" 
                              Background="Transparent" RowHeight="36" HeadersVisibility="Column" 
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155" BorderThickness="0">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#0F172A" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Foreground" Value="White" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Invoice #" Binding="{Binding InvoiceNumber}" Width="160"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding SaleDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="140"/>
                            <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=₹{0:N2}}" Width="100"/>
                            <DataGridTextColumn Header="Discount" Binding="{Binding TotalDiscount, StringFormat=₹{0:N2}}" Width="90"/>
                            <DataGridTextColumn Header="GST Tax" Binding="{Binding TotalTax, StringFormat=₹{0:N2}}" Width="90"/>
                            <DataGridTextColumn Header="Grand Total" Binding="{Binding GrandTotal, StringFormat=₹{0:N2}}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Fast-Moving vs Dead Stock">
                    <DataGrid x:Name="DgProductVelocity" AutoGenerateColumns="False" IsReadOnly="True" 
                              Background="Transparent" RowHeight="36" HeadersVisibility="Column" 
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155" BorderThickness="0">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#0F172A" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Foreground" Value="White" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="120"/>
                            <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="Units Sold" Binding="{Binding UnitsSold}" Width="100"/>
                            <DataGridTextColumn Header="Revenue Generated" Binding="{Binding RevenueGenerated, StringFormat=₹{0:N2}}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Page>
